# Stable build refs.
#
# Values can be Git tags, branches, or commit SHAs. The stable CI passes this
# file as VERSION_MANIFEST, and scripts/build.sh checks out each ref after
# cloning the matching upstream repository.
REF_WAYLAND_PROTOCOLS=1.49
REF_GLAZE=v7.9.1 # Latest tag v8.1.0 is incompatible with Hyprland v0.56.2, which requires glaze <8.
REF_HYPRWAYLAND_SCANNER=v0.4.6
REF_HYPRUTILS=v0.14.1
REF_AQUAMARINE=v0.14.0
REF_HYPRLANG=v0.6.8
REF_HYPRCURSOR=v0.1.13
REF_HYPRGRAPHICS=v0.5.1
REF_HYPRLAND_PROTOCOLS=1cb6db5 # Latest tag v0.7.0 lacks CMake; keep post-tag CMake commit.
REF_HYPRWIRE=v0.3.1
REF_HYPRTOOLKIT=v0.5.4
REF_HYPRLAND=v0.56.2
REF_QUICKSHELL=v0.3.1
REF_HYPRIDLE=v0.1.8
REF_HYPRLOCK=v0.9.6
REF_HYPRPAPER=v0.8.4
REF_HYPRPICKER=v0.4.7
REF_HYPRSUNSET=v0.4.0
REF_HYPRPOLKITAGENT=v0.1.3
REF_HYPRSYSTEMINFO=v0.2.0
REF_HYPRLAUNCHER=v0.1.6
REF_XDG_DESKTOP_PORTAL_HYPRLAND=v1.4.1
REF_HYPRLAND_GUIUTILS=v0.2.2
REF_HYPRLAND_QT_SUPPORT=9ef7f6 # Keep post-v0.1.0 commit currently newer than latest tag.
REF_HYPRQT6ENGINE=0021cc2 # Latest tag v0.1.0 links Qt6::GuiPrivate without finding it; keep post-tag fix.
REF_UWSM=v0.26.6
REF_HYPRSHOT=1.3.0
