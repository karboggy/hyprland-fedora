# Stable build refs.
#
# Values can be Git tags, branches, or commit SHAs. The stable CI passes this
# file as VERSION_MANIFEST, and scripts/build.sh checks out each ref after
# cloning the matching upstream repository.
REF_WAYLAND_PROTOCOLS=1.50
REF_GLAZE=v7.9.1 # Hyprland v0.57.2's hyprpm/start require glaze 7...<8; keep the latest 7.x tag.
REF_HYPRWAYLAND_SCANNER=v0.4.6
REF_HYPRUTILS=v0.14.3
REF_AQUAMARINE=v0.16.0
REF_HYPRLANG=v0.6.8
REF_HYPRCURSOR=v0.1.14
REF_HYPRGRAPHICS=v0.6.0
REF_HYPRLAND_PROTOCOLS=v0.8.0 # Includes CMake and the workspace capture protocol required by Hyprland/XDPH.
REF_HYPRWIRE=v0.3.1
REF_HYPRTOOLKIT=v0.6.0
REF_HYPRLAND=v0.57.2
REF_QUICKSHELL=v0.3.2
REF_HYPRIDLE=v0.1.8
REF_HYPRLOCK=v0.9.7
REF_HYPRPAPER=v0.8.5
REF_HYPRPICKER=v0.4.8
REF_HYPRSUNSET=v0.4.0
REF_HYPRPOLKITAGENT=v0.2.0
REF_HYPRSYSTEMINFO=v0.2.0
REF_HYPRLAUNCHER=v0.1.7
REF_XDG_DESKTOP_PORTAL_HYPRLAND=v1.5.0 # First release with workspace sharing; picker requires hyprtoolkit >=0.6.0.
REF_HYPRLAND_GUIUTILS=v0.2.2
REF_HYPRLAND_QT_SUPPORT=9ef7f6 # v0.1.0 still lacks the PkgConfig::hyprlang link fix; keep the post-tag commit.
REF_HYPRQT6ENGINE=0021cc2 # Latest tag v0.1.0 links Qt6::GuiPrivate without finding it; keep post-tag fix.
REF_UWSM=v0.27.2
REF_HYPRSHOT=1.3.0
